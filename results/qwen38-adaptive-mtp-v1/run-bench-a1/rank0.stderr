 of the two ends. Otherwise, append it as a new merged interval.\n\n    Since intervals are closed, [1, 3] and [3, 5] overlap at point 3 and should be merged.\n    \"\"\"\n    if not intervals:\n        return []\n\n    # Sort by start value\n    sorted_intervals = sorted(intervals, key=lambda x: x[0])\n\n    merged: List[Tuple[int, int]] = [sorted_intervals[0]]\n\n    for current in sorted_intervals[1:]:\n        last = merged[-1]\n        # Check for overlap: current start <= last end (", "wall_seconds": 54.569415624951944, "first_token_seconds": 15.828131082933396, "wall_tokens_per_second": 4.691272520846708, "native_generation_tps": null, "prompt_tokens": 1536, "finish_reason": "length", "accepted_drafts": 0, "verification_rounds": 0, "teacher_forwards": 0, "id": "code-1536-native-r0", "case_id": "code-1536", "method": "native", "warmup": false, "max_tokens": 256, "repeat": 10, "sample_repeat": 0, "eval_group_size": 32, "prompt_sha256": "a465bc2c4b3acda5e79a9cd4012e4f1afbe677d9198cdcea2e521b46537d4250", "prompt_token_ids": [248045, 846, 198, 760, 2614, 26388, 14246, 17593, 369, 3870, 1132, 13, 21134, 279, 41559, 1238, 424, 26, 635, 524, 59987, 466, 2880, 279, 17593, 13, 198, 27, 15547, 29, 198, 41089, 3150, 220, 15, 15, 15, 15, 25, 264, 11525, 3816, 2531, 12, 15, 15, 15, 15, 26, 424, 12076, 264, 25293, 9463, 1518, 58565, 279, 1622, 13, 1061, 3150, 369, 3870, 2193, 11, 524, 449, 7359, 13, 198, 41089, 3150, 220, 15, 15, 15, 16, 25, 264, 11525, 3816, 2531, 12, 15, 15, 15, 16, 26, 424, 12076, 264, 25293, 9463, 1518, 58565, 279, 1622, 13, 1061, 3150, 369, 3870, 2193, 11, 524, 449, 7359, 13, 198, 41089, 3150, 220, 15, 15, 15, 17, 25, 264, 11525, 3816, 2531, 12, 15, 15, 15, 17, 26, 424, 12076, 264, 25293, 9463, 1518, 58565, 279, 1622, 13, 1061, 3150, 369, 3870, 2193, 11, 524, 449, 7359, 13, 198, 41089, 3150, 220, 15, 15, 15, 18, 25, 264, 11525, 3816, 2531, 12, 15, 15, 15, 18, 26, 424, 12076, 264, 25293, 9463, 1518, 58565, 279, 1622, 13, 1061, 3150, 369, 3870, 2193, 11,