+            "recv_called",
+            "evaluated",
+            "handoff_receive_done",
+            "block_before",
+        ]
+    else:
+        assert [e["phase"] for e in trace[-5:]] == [
+            "evaluated",
+            "handoff_send_before",
+            "send_called",
+            "evaluated",
+            "handoff_send_done",
