{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paretoquant:qwen38-prefill-overlap:cpu-contract:v1",
  "title": "Qwen3.8 overlap CPU structural contract v1",
  "description": "Structural schema only. Semantic auditors and independently pinned manifests are mandatory. This is NOT the raw025 runtime receipt schema, physical numerical admission, or performance acceptance.",
  "x-integration-status": "pending_runtime025_adapter_and_independent_review",
  "oneOf": [
    {"$ref": "#/$defs/schedule"},
    {"$ref": "#/$defs/batch"},
    {"$ref": "#/$defs/trusted"},
    {"$ref": "#/$defs/record"}
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "case_id", "method", "prompt", "max_tokens", "warmup", "repeat", "prefill_mode", "source_request_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "case_id": {"type": "string", "minLength": 1},
        "method": {"const": "mtp"},
        "prompt": {"type": "string", "minLength": 1},
        "max_tokens": {"type": "integer", "minimum": 1, "maximum": 512},
        "warmup": {"type": "boolean"},
        "repeat": {"type": "integer", "minimum": 0, "maximum": 1},
        "prefill_mode": {"enum": ["serial", "overlap"]},
        "source_request_id": {"type": "string", "minLength": 1}
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "requests"],
      "properties": {
        "schema": {"const": "qwen38-prefill-overlap-schedule-v1"},
        "requests": {"type": "array", "minItems": 6, "maxItems": 14, "items": {"$ref": "#/$defs/request"}}
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "historical_manifest_sha256", "design_sha256", "population", "cases", "batches"],
      "properties": {
        "schema": {"const": "qwen38-prefill-overlap-schedule-v1"},
        "historical_manifest_sha256": {"const": "b20a600c3889d62cdf15a7faa6c2ca90611084ceae15b9a8dea7f7823d5a29e6"},
        "design_sha256": {"const": "710703230b23461193337e78c8a38e1c72675e19f6d747c614c14c7211ac95f0"},
        "population": {"enum": ["full84", "pilot6"]},
        "cases": {"type": "array", "minItems": 18, "maxItems": 18, "items": {"type": "object"}},
        "batches": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/batch"}}
      }
    },
    "configuration": {
      "type": "object",
      "required": ["model", "revision", "split", "eval_group_size", "verifier_modes", "precision", "hidden_only_prefill", "overlapped_prefill", "prefix_rollback", "require_normal_pressure", "prefill_chunk_size", "max_simultaneous_chunks", "max_pending_handoffs", "control_frame_bytes"],
      "properties": {
        "model": {"const": "mlx-community/Qwen3.8-27B-4bit"},
        "revision": {"const": "10c35caafbb80f7dc6a7a432cdd11af10a6d4818"},
        "split": {"const": [28, 36]},
        "eval_group_size": {"const": 32},
        "verifier_modes": {"const": ["native", "slot-qmv"]},
        "precision": {"const": "Q4/BF16"},
        "hidden_only_prefill": {"const": true},
        "overlapped_prefill": {"const": true},
        "prefix_rollback": {"const": true},
        "require_normal_pressure": {"const": true},
        "prefill_chunk_size": {"const": 256},
        "max_simultaneous_chunks": {"const": 2},
        "max_pending_handoffs": {"const": 1},
        "control_frame_bytes": {"const": 65536}
      },
      "additionalProperties": false
    },
    "trusted": {
      "type": "object",
      "description": "Independently supplied hash-pinned manifest, not reconstructed from submitted receipts. Full semantic contents are specified in CONTRACT.md and evidence.py.",
      "required": ["schema", "artifact_kind", "sources", "required_source_names", "configuration", "metadata_sha256", "tensor_sha256_by_rank", "guard_source_sha256", "max_pressure_gap_seconds", "requests", "numerical_plan_by_rank", "raw_artifacts"],
      "properties": {
        "schema": {"const": "qwen38-overlap-trusted-input-v1"},
        "artifact_kind": {"enum": ["TEST_FIXTURE_NOT_MODEL_RESULTS", "PHYSICAL_RECEIPT"]},
        "configuration": {"$ref": "#/$defs/configuration"},
        "sources": {"type": "object", "minProperties": 1},
        "required_source_names": {"type": "array", "uniqueItems": true, "minItems": 1},
        "requests": {"type": "object", "minProperties": 6, "maxProperties": 14},
        "numerical_plan_by_rank": {"type": "array", "minItems": 2, "maxItems": 2},
        "raw_artifacts": {"type": "object"}
      }
    },
    "record": {
      "type": "object",
      "description": "PROPOSED normalized CPU evidence envelope. Raw025 adapter remains pending; schema validity cannot grant acceptance.",
      "required": ["schema", "artifact_kind", "batch_index", "configuration", "sources", "metadata_sha256", "cleanup", "ranks", "request_evidence"],
      "properties": {
        "schema": {"const": "qwen38-overlap-normalized-record-v1"},
        "artifact_kind": {"enum": ["TEST_FIXTURE_NOT_MODEL_RESULTS", "PHYSICAL_RECEIPT"]},
        "batch_index": {"type": "integer", "minimum": 0, "maximum": 5},
        "configuration": {"$ref": "#/$defs/configuration"},
        "ranks": {"type": "array", "minItems": 2, "maxItems": 2},
        "request_evidence": {"type": "array", "minItems": 6, "maxItems": 14}
      }
    }
  }
}
